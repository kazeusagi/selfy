# 開発用の環境変数。`cp .env.example .env` でコピーして使ってください
# 本番の値は `.env` からは読み込まれないので、`bunx void secret put <NAME>` で設定します

# Resend の API キー。開発中のメールはローカルの受信箱に届くので、ダミーで構いません
RESEND_API_KEY=dummy

# 管理者のメールアドレス。最初にログインできるのはこのアドレスだけです
ADMIN_EMAIL=you@example.com

# メールの送信元アドレス。本番では Resend で認証したドメインのものにします
EMAIL_FROM=noreply@example.com
