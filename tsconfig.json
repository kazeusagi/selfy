{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "void/env",
      "vite/client"
    ]
    ,"jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "void/db": ["./.void/db.d.ts"],
      "@schema": ["./src/db/schema.ts"],
      "@schema/*": ["./src/db/schema/*"],
      "void/routes": ["./.void/routes.d.ts"]
    }
  },
  "include": [
    "src",
    "pages",
    "routes",
    "middleware",
    "crons",
    "queues",
    "db"
  ]
}
